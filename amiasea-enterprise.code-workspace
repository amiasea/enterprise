{
  "folders": [
    {
      "name": "amiasea-enterprise",
      "path": "."
    },
    {
      "name": "amiasea-enterprise-daggerverse",
      "path": "../amiasea-enterprise-daggerverse"
    },
    {
      "name": "amiasea-image-utility",
      "path": "../amiasea-image-utility"
    },
  ],
"settings": {
    "terminal.integrated.profiles.windows": {
      "PowerShell": {
        "source": "PowerShell",
        "args": [
          "-NoExit",
          "-Command",
          "$credentials = Get-Content \"$env:USERPROFILE\\AppData\\Roaming\\terraform.d\\credentials.tfrc.json\" -Raw | ConvertFrom-Json; $env:TFE_TOKEN = $credentials.credentials.'app.terraform.io'.token"
        ]
      }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.indentSize": 2,
    "editor.detectIndentation": false,
    "dotnet.defaultSolution": "amiasea-enterprise/Amiasea.Enterprise.slnx"
	}
}